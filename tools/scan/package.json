{
  "name": "@dsh-bridge/scan",
  "version": "0.1.0",
  "description": "Static scanner for DSH plugins: the analysis engine behind dsh-bridge trust report cards.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "bin": {
    "dsh-scan": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "default": "./dist/rules/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test dist/self-test.js",
    "scan": "node dist/index.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "static-analysis",
    "security",
    "supply-chain",
    "plugin-audit"
  ],
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {}
}
